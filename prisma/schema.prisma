model Batch {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  batchNumber String
  session     String
}

model trade {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
}

model Student {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  fatherName         String
  motherName         String
  bloodGroup         String
  gender             String
  phoneNumber        String            @unique
  parentsPhoneNumber String
  email              String?
  nidNumber          String            @unique
  birthRegNumber     String?           @unique
  dob                String?
  religion           String?
  presentAddress     Address[]
  educationResult    EducationResult[]
}

model Address {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  village    String
  postOffice String
  wardNo     String
  thana      String
  district   String
  division   String
  Student    Student? @relation(fields: [studentId], references: [id])
  studentId  String?  @db.ObjectId
}

model EducationResult {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  type           String
  subjectName    String?
  gpa            String?
  rollNumber     String?
  registerNumber String?
  passedYear     String?
  board          String?

  Student   Student? @relation(fields: [studentId], references: [id])
  studentId String?  @db.ObjectId
}
